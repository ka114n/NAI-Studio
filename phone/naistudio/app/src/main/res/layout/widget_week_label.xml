<?xml version="1.0" encoding="utf-8"?>
<!--
    日历的**星期表头**一格（一 / 二 / 三 … 日）。

    ⚠️ 宽度必须和 [widget_heatmap_cell] **用同一套规则**（1.1.116 口径：
       `0dp` + `columnWeight=1`），否则星期几和下面的日期列会**错开**。
    ⚠️ 单层、权重留在自己根上（不要嵌套 —— 嵌套会让 LayoutParams 传丢）。
    ⚠️ 控件必须在 `RemoteViews` 白名单里 ⇒ 只用 `TextView`。
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/week_label"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_margin="0.5dp"
    android:gravity="center"
    android:textSize="8sp"
    android:maxLines="1"
    android:textColor="@color/widget_text_dim" />
