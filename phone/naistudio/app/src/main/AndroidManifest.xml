<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 唯一必需权限：调用 NovelAI API。其余权限在对应功能落地时逐个加入。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NAIStudio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            桌面小组件 —— **两个样式，各一个 receiver**（用户 2026-09-26：
            「应该直接做两个样式，一个余额，一个统计加余额」）。

            ⚠️ 早前是**一个** Provider 靠尺寸判布局 ⇒ 选择器里只有一条、显示成哪样由启动器
               报的 dp 决定（拉大拉小就变脸），用户挑不了。现在拆成两条。

            ⚠️ `exported="true"` 是**必须**的：小组件广播由 **systemui / 启动器**发过来，
               那是别的进程，不导出收不到（Android 12+ 不写还会直接编不过）。
            ⚠️ 不新增任何权限、也没有 FileProvider —— 纯文字（余额 + 数字），不显示图片。
        -->
        <receiver
            android:name=".widget.BalanceOnlyWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_balance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nai_balance_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BalanceStatsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_balance_stats">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nai_balance_stats_widget_info" />
        </receiver>

        <!--
            `‹ ›` 切月份的接收器（用户 2026-09-26：「可滑动切换月份」——
            小组件**收不到滑动手势**，只能做成点箭头，见 `WidgetMonthReceiver` 的说明）。

            ⚠️ `exported="false"`：这条广播**只有本 App 自己发**（小组件的 PendingIntent），
               不像上面两个 receiver 要从 systemui 收系统广播 ⇒ **不该导出**（更安全）。
        -->
        <receiver
            android:name=".widget.WidgetMonthReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kallan.naistudio.widget.MONTH_STEP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
